# Each invocation keeps its own complete fixture/output history (including failures).
if(NOT DEFINED COMPILER OR NOT DEFINED SHADERS OR NOT DEFINED WORK_ROOT)
    message(FATAL_ERROR "Missing shader test paths")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run)
set(work "${WORK_ROOT}/${run}")
if(EXISTS "${work}")
    message(FATAL_ERROR "Preserve existing test run")
endif()
file(MAKE_DIRECTORY "${work}/inputs")
foreach(name GuiVertex GuiImage)
    file(COPY "${SHADERS}/${name}.hlsl" DESTINATION "${work}/inputs")
endforeach()
function(compile output expected)
    execute_process(COMMAND "${COMPILER}" "${work}/inputs" "${output}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    file(APPEND "${work}/execution.log" "${output}\nexit=${result}\n${stdout}\n${stderr}\n")
    if(expected STREQUAL "pass")
        if(NOT result EQUAL 0 OR NOT EXISTS "${output}")
            message(FATAL_ERROR "Valid fixed shader compilation failed; see ${work}")
        endif()
    elseif(result EQUAL 0)
        message(FATAL_ERROR "Invalid shader/output unexpectedly accepted; see ${work}")
    endif()
endfunction()
compile("${work}/first.h" pass)
compile("${work}/second.h" pass)
file(SHA256 "${work}/first.h" original)
file(SHA256 "${work}/second.h" repeated)
if(NOT original STREQUAL repeated)
    message(FATAL_ERROR "Same inputs produced different shader bytes")
endif()
file(READ "${work}/first.h" generated)
foreach(symbol NcmaGuiVertexBytecode NcmaGuiImageBytecode)
    if(NOT generated MATCHES "${symbol}")
        message(FATAL_ERROR "Missing generated shader ${symbol}")
    endif()
endforeach()
if(generated MATCHES "NcmaGuiFontBytecode")
    message(FATAL_ERROR "Retired separate font shader is still generated")
endif()
# A failure in either input must fail the whole generation and leave
# earlier output unchanged. No build-time stale-success or runtime fallback.
foreach(name GuiVertex GuiImage)
    file(WRITE "${work}/inputs/${name}.hlsl" "this is invalid HLSL;\n")
    compile("${work}/first.h" fail)
    file(SHA256 "${work}/first.h" after)
    if(NOT original STREQUAL after)
        message(FATAL_ERROR "Failed compilation changed earlier bytecode")
    endif()
    file(COPY_FILE "${SHADERS}/${name}.hlsl" "${work}/inputs/${name}.hlsl")
endforeach()
file(WRITE "${work}/inputs/GuiImage.hlsl" "")
compile("${work}/absent.h" fail)
if(EXISTS "${work}/absent.h")
    message(FATAL_ERROR "Invalid source produced an output")
endif()
file(COPY_FILE "${SHADERS}/GuiImage.hlsl" "${work}/inputs/GuiImage.hlsl")
compile("${work}/missing-parent/bytes.h" fail)
# Output path is an existing directory: writer must not report success.
compile("${work}/inputs" fail)
message(STATUS "PASS GUI shader build: deterministic two-shader bytes, no retired font blob, both syntax failures preserve earlier output, empty input/no output, missing parent and directory output rejected; ${work}")
