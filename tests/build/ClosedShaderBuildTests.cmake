# Isolated build-host failure cases; every invocation preserves a new fixture tree.
foreach(required COMPILER SOURCE_ROOT WORK_ROOT CXX MAKE_PROGRAM GENERATOR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run)
set(work "${WORK_ROOT}/${run}")
if(EXISTS "${work}")
    message(FATAL_ERROR "Preserve existing fixture")
endif()
file(MAKE_DIRECTORY "${work}/inputs/renderer")
function(compile tool output expect)
    execute_process(COMMAND "${tool}" "${output}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    file(APPEND "${work}/execution.log" "${tool}\n${output}\nexit=${result}\n${stdout}\n${stderr}\n")
    if(expect STREQUAL "pass")
        if(NOT result EQUAL 0 OR NOT EXISTS "${output}")
            message(FATAL_ERROR "Reference generation failed: ${work}")
        endif()
    elseif(result EQUAL 0)
        message(FATAL_ERROR "Invalid reference generation accepted: ${work}")
    endif()
endfunction()
compile("${COMPILER}" "${work}/first.h" pass)
compile("${COMPILER}" "${work}/second.h" pass)
file(SHA256 "${work}/first.h" original)
file(SHA256 "${work}/second.h" repeated)
if(NOT original STREQUAL repeated)
    message(FATAL_ERROR "Non-deterministic references")
endif()
compile("${COMPILER}" "${work}/missing-parent/output.h" fail)
compile("${COMPILER}" "${work}/inputs" fail)
# Compile the actual tool against a copied source with syntactically invalid HLSL.
# C++ remains valid; failure must occur at generation, before old output is opened.
foreach(name ClosedShaderSources.h ClosedShaderDefinitions.h)
    file(COPY "${SOURCE_ROOT}/engine/source/plugins/renderer/${name}" DESTINATION "${work}/inputs/renderer")
endforeach()
file(COPY "${SOURCE_ROOT}/tools/renderer-shaders/CompileClosedReferences.cpp" DESTINATION "${work}/inputs")
file(READ "${work}/inputs/renderer/ClosedShaderSources.h" source)
string(REPLACE "cbuffer C:register(b0)" "invalid_hlsl C:register(b0)" invalid "${source}")
if(invalid STREQUAL source)
    message(FATAL_ERROR "Mutation did not apply")
endif()
file(WRITE "${work}/inputs/renderer/ClosedShaderSources.h" "${invalid}")
file(WRITE "${work}/inputs/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(BadClosedReference LANGUAGES CXX)\nset(CMAKE_CXX_STANDARD 20)\nadd_executable(BadReference CompileClosedReferences.cpp)\ntarget_include_directories(BadReference PRIVATE .)\ntarget_compile_definitions(BadReference PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)\ntarget_compile_options(BadReference PRIVATE /W4 /WX /permissive- /utf-8)\ntarget_link_libraries(BadReference PRIVATE d3dcompiler)\n")
get_filename_component(compilerDirectory "${CXX}" DIRECTORY)
get_filename_component(vcvars "${compilerDirectory}/../../../../../../Auxiliary/Build/vcvars64.bat" ABSOLUTE)
if(NOT EXISTS "${vcvars}")
    message(FATAL_ERROR "MSVC environment entry not found: ${vcvars}")
endif()
# CTest may be launched outside a developer shell. Re-enter the same x64 toolchain
# for this isolated helper; no user environment or product build settings change.
file(WRITE "${work}/build-fixture.bat"
    "@echo off\ncall \"${vcvars}\" >nul\nif errorlevel 1 exit /b 1\n\"${CMAKE_COMMAND}\" -S \"${work}/inputs\" -B \"${work}/build\" -G \"${GENERATOR}\" \"-DCMAKE_CXX_COMPILER=${CXX}\" \"-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}\" -DCMAKE_BUILD_TYPE=Release\nif errorlevel 1 exit /b 1\n\"${CMAKE_COMMAND}\" --build \"${work}/build\" --config Release\nexit /b %errorlevel%\n")
execute_process(COMMAND cmd /d /c "${work}/build-fixture.bat" RESULT_VARIABLE built OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 120)
file(APPEND "${work}/execution.log" "build=${built}\n${stdout}\n${stderr}\n")
if(NOT built EQUAL 0)
    message(FATAL_ERROR "Cannot build negative fixture: ${work}")
endif()
set(badCompiler "${work}/build/BadReference.exe")
if(GENERATOR MATCHES "Visual Studio|Multi-Config")
    set(badCompiler "${work}/build/Release/BadReference.exe")
endif()
if(NOT EXISTS "${badCompiler}")
    message(FATAL_ERROR "Missing negative fixture executable")
endif()
compile("${badCompiler}" "${work}/first.h" fail)
file(SHA256 "${work}/first.h" after)
if(NOT original STREQUAL after)
    message(FATAL_ERROR "Invalid HLSL overwrote prior output")
endif()
compile("${badCompiler}" "${work}/absent.h" fail)
if(EXISTS "${work}/absent.h")
    message(FATAL_ERROR "Invalid HLSL produced output")
endif()
message(STATUS "PASS closed references: deterministic 16 shaders, rejected output paths, actual invalid HLSL rejected without stale overwrite/output; ${work}")
