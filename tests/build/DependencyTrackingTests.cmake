cmake_minimum_required(VERSION 3.25)
if(DEFINED PREFIX_FILE)
    include("${PREFIX_FILE}")
endif()
foreach(required SOURCE_ROOT WORK_ROOT CC CXX MAKE_PROGRAM CORRECT_PREFIX CONFIG)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT CONFIG MATCHES "^(Release|Debug|RelWithDebInfo|MinSizeRel)$")
    message(FATAL_ERROR "Unsupported fixture configuration")
endif()

if(NOT WORKER)
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run)
    set(work "${WORK_ROOT}/${run}")
    if(EXISTS "${work}")
        message(FATAL_ERROR "Preserve existing regression evidence")
    endif()
    file(MAKE_DIRECTORY "${work}")
    get_filename_component(compiler_directory "${CXX}" DIRECTORY)
    get_filename_component(vcvars "${compiler_directory}/../../../../../../Auxiliary/Build/vcvars64.bat" ABSOLUTE)
    if(NOT EXISTS "${vcvars}")
        message(FATAL_ERROR "Missing matching MSVC environment: ${vcvars}")
    endif()
    # Store input values in CMake, not a shell command (notably the UTF-8 prefix).
    set(parameters "")
    foreach(name SOURCE_ROOT WORK_ROOT CC CXX MAKE_PROGRAM CORRECT_PREFIX CONFIG)
        if("${${name}}" MATCHES "\\]=\\]")
            message(FATAL_ERROR "Unsupported bracket delimiter in ${name}")
        endif()
        string(APPEND parameters "set(${name} [=[${${name}}]=])\n")
    endforeach()
    file(WRITE "${work}/worker.cmake" "${parameters}set(WORKER ON)\nset(work [=[${work}]=])\ninclude([=[${CMAKE_CURRENT_LIST_FILE}]=])\n")
    file(WRITE "${work}/run.bat"
        "@echo off\ncall \"${vcvars}\" >nul\nif errorlevel 1 exit /b 1\nset VSLANG=1033\n\"${CMAKE_COMMAND}\" -P \"${work}/worker.cmake\"\nexit /b %errorlevel%\n")
    execute_process(COMMAND cmd /d /c "${work}/run.bat" RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 280)
    file(WRITE "${work}/worker.log" "exit=${result}\n${stdout}\n${stderr}")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Dependency regression failed; preserved ${work}: ${stderr}")
    endif()
    message(STATUS "${stdout}")
    return()
endif()

file(COPY "${SOURCE_ROOT}/tests/build/dependency-tracking/" DESTINATION "${work}/source")
file(COPY_FILE "${SOURCE_ROOT}/engine/build/cmake/NcmaDependencyTracking.cmake" "${work}/Tracking.cmake")
function(run_step label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr TIMEOUT 90)
    file(WRITE "${work}/${label}.stdout" "${stdout}")
    file(WRITE "${work}/${label}.stderr" "${stderr}")
    file(WRITE "${work}/${label}.exit" "${result}\n")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Failed ${label}: ${result}; ${work}")
    endif()
    set(step_output "${stdout}" PARENT_SCOPE)
endfunction()
function(configure_fixture label prefix)
    # Cache -D string values strip trailing whitespace. Preserve the exact parser
    # bytes through a CMake include, just as the production set() does.
    file(WRITE "${work}/${label}.prefix.cmake" "set(TEST_PREFIX [=[${prefix}]=])\n")
    run_step("${label}" "${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/build" -G Ninja
        "-DCMAKE_C_COMPILER=${CC}" "-DCMAKE_CXX_COMPILER=${CXX}"
        "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}" "-DCMAKE_BUILD_TYPE=${CONFIG}"
        "-DTEST_PREFIX_FILE=${work}/${label}.prefix.cmake" "-DTRACKING_MODULE=${work}/Tracking.cmake")
    file(COPY_FILE "${work}/build/compile_commands.json" "${work}/${label}.commands.json")
    file(READ "${work}/${label}.commands.json" commands)
    string(REGEX MATCHALL "NCMA_DEPENDENCY_PARSER_[0-9a-f]+=1" fingerprints "${commands}")
    list(LENGTH fingerprints count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Both C and CXX must carry the parser identity")
    endif()
    list(REMOVE_DUPLICATES fingerprints)
    list(LENGTH fingerprints count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Inconsistent parser identity")
    endif()
    set(fingerprint "${fingerprints}" PARENT_SCOPE)
endfunction()
function(build_two label)
    run_step("${label}" "${CMAKE_COMMAND}" --build "${work}/build" --verbose)
    string(REGEX MATCHALL "NCMA_DEPENDENCY_PARSER_[0-9a-f]+=1" compiles "${step_output}")
    list(LENGTH compiles count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Expected two actual compiler commands in ${label}; got ${count}")
    endif()
endfunction()
function(check_deps label expected)
    run_step("${label}" "${MAKE_PROGRAM}" -C "${work}/build" -t deps)
    string(REGEX MATCHALL "#deps [0-9]+, deps mtime [0-9]+ \\(VALID\\)" records "${step_output}")
    list(LENGTH records count)
    if(NOT count EQUAL 2 OR step_output MATCHES "STALE")
        message(FATAL_ERROR "Expected exactly two valid object dependency records")
    endif()
    if(expected STREQUAL "empty")
        string(REGEX MATCHALL "#deps 0," empty_records "${step_output}")
        list(LENGTH empty_records count)
        if(NOT count EQUAL 2)
            message(FATAL_ERROR "Wrong-prefix negative control did not produce two empty records")
        endif()
    else()
        # Ninja canonicalizes headers inside the fixture to relative paths.
        # Resolve each actual record against its build directory, not a textual
        # absolute-path substring (which rejects legitimate relative records).
        string(REPLACE "\r" "" lines "${step_output}")
        string(REPLACE "\n" ";" lines "${lines}")
        string(TOLOWER "${work}/source/tracked.h" header)
        set(headers 0)
        foreach(line IN LISTS lines)
            if(line MATCHES "#deps")
                if(NOT line MATCHES "#deps 1,")
                    message(FATAL_ERROR "Expected one known header per fixture object")
                endif()
            elseif(line MATCHES "^    (.+)$")
                get_filename_component(actual "${CMAKE_MATCH_1}" ABSOLUTE BASE_DIR "${work}/build")
                string(TOLOWER "${actual}" actual)
                if(NOT actual STREQUAL header)
                    message(FATAL_ERROR "Unexpected dependency instead of the known local header: ${actual}")
                endif()
                math(EXPR headers "${headers} + 1")
            elseif(NOT line STREQUAL "")
                message(FATAL_ERROR "Unexpected dependency output: ${line}")
            endif()
        endforeach()
        if(NOT headers EQUAL 2)
            message(FATAL_ERROR "Known local header missing from actual records")
        endif()
    endif()
endfunction()

configure_fixture(wrong-config "__NCMA_INTENTIONALLY_INVALID_INCLUDE_PREFIX__")
set(wrong_fingerprint "${fingerprint}")
build_two(wrong-build)
check_deps(wrong-deps empty)
configure_fixture(correct-config "${CORRECT_PREFIX}")
if(fingerprint STREQUAL wrong_fingerprint)
    message(FATAL_ERROR "Parser change did not change compile identity")
endif()
set(correct_fingerprint "${fingerprint}")
build_two(correct-build)
check_deps(correct-deps tracked)
configure_fixture(unchanged-config "${CORRECT_PREFIX}")
if(NOT fingerprint STREQUAL correct_fingerprint)
    message(FATAL_ERROR "Unchanged parser identity is not stable")
endif()
run_step(unchanged-build "${CMAKE_COMMAND}" --build "${work}/build" --verbose)
if(NOT step_output MATCHES "no work to do" OR step_output MATCHES "NCMA_DEPENDENCY_PARSER_")
    message(FATAL_ERROR "Unchanged configuration unexpectedly rebuilt")
endif()
file(WRITE "${work}/source/tracked.h" "#define NCMA_TRACKED_VALUE 29\n")
build_two(header-change-build)
check_deps(header-change-deps tracked)
message(STATUS "PASS ${CONFIG}: C/CXX wrong-prefix zero-deps controls, corrected-prefix rebuild and known-header tracking, stable no-op, header-change rebuild; ${work}")
