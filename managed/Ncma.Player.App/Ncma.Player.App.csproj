<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>NcmaPlayer</AssemblyName><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>../../engine/build/resources/NcmaEngine.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed><PublishAot>false</PublishAot><PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <!-- Same generated component module as optional Editor; never loads editor tools. -->
  <ItemGroup Condition="'$(NcmaEnableExtensions)' == 'true'">
    <ProjectReference Include="../Ncma.Extensions.Hosting/Ncma.Extensions.Hosting.csproj" />
  </ItemGroup>
  <Target Name="CheckOptionalExtensionPlayer" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NcmaEnableExtensions)' != '' and '$(NcmaEnableExtensions)' != 'false' and '$(NcmaEnableExtensions)' != 'true'" Text="NcmaEnableExtensions must be true or false." />
    <Error Condition="'$(NcmaEnableExtensions)' == 'true' and '$(ArtifactsPath)' == ''" Text="Extension Player requires an explicit isolated ArtifactsPath." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Ncma.Rendering.Tests" />
    <ProjectReference Include="../Ncma.Application.Runtime/Ncma.Application.Runtime.csproj" />
    <ProjectReference Include="../Ncma.Rendering/Ncma.Rendering.csproj" />
    <ProjectReference Include="../Ncma.Ui.Rendering/Ncma.Ui.Rendering.csproj" />
    <ProjectReference Include="../Ncma.Scene.Rendering/Ncma.Scene.Rendering.csproj" />
    <ProjectReference Include="../Ncma.Rendering.Scene/Ncma.Rendering.Scene.csproj" />
    <ProjectReference Include="../Ncma.Physics/Ncma.Physics.csproj" />
    <ProjectReference Include="../Ncma.Characters/Ncma.Characters.csproj" />
    <None Include="../../engine/build/resources/NcmaEngine.ico" Link="NcmaEngine.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
